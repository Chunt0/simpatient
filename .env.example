# Copy this to .env and adjust as needed.

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL_INTERNAL=http://livekit:7880
LIVEKIT_URL_PUBLIC=ws://localhost:7880   # use wss:// if behind HTTPS reverse proxy; must match livekit.yaml turn.domain for TURN to work

# TTS voice (Kokoro)
KOKORO_VOICE=af_nova

# API / Frontend
FRONTEND_ORIGIN=http://localhost:3000
API_PORT=4000

# ─── LLM (vLLM) ───────────────────────────────────────────────────────────────
VLLM_MODEL=unsloth/gemma-4-E4B-it
VLLM_SERVED_NAME=gemma
VLLM_QUANTIZATION=fp8
VLLM_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_NUM_SEQS=4
HF_TOKEN=

# ─── Latency knobs ────────────────────────────────────────────────────────────
# RESPONSE_DELAY_MS: wall-clock pause before the LLM responds (raise if the bot
# feels "too snappy"). MIN/MAX_ENDPOINTING_DELAY: turn-detector silence window.
RESPONSE_DELAY_MS=0
MIN_ENDPOINTING_DELAY=0.5
MAX_ENDPOINTING_DELAY=3.0
PREEMPTIVE_GENERATION=true
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7
